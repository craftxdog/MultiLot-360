@baseUrl = http://localhost:3000/api/v1
@adminToken = REPLACE_WITH_SUPABASE_ADMIN_ACCESS_TOKEN
@sellerToken = REPLACE_WITH_SUPABASE_SELLER_ACCESS_TOKEN
@refreshToken = REPLACE_WITH_SUPABASE_REFRESH_TOKEN
@date = 2026-07-05
@configurationId = 00000000-0000-4000-8000-000000000001
@shiftId = 00000000-0000-4000-8000-000000000002
@sellerId = 00000000-0000-4000-8000-000000000003
@userId = 00000000-0000-4000-8000-000000000004
@invitationId = 00000000-0000-4000-8000-000000000005
@limitId = 00000000-0000-4000-8000-000000000006
@blockId = 00000000-0000-4000-8000-000000000007
@saleId = 00000000-0000-4000-8000-000000000008
@resultId = 00000000-0000-4000-8000-000000000009
@cutId = 00000000-0000-4000-8000-000000000010
@auditEventId = 1
@roleId = 00000000-0000-4000-8000-000000000011
@notificationId = 00000000-0000-4000-8000-000000000012

### Sistema

# ROUTE: GET /
GET {{baseUrl}}

###
# ROUTE: GET /health
GET {{baseUrl}}/health

###
# ROUTE: GET /health/ready
GET {{baseUrl}}/health/ready

### Autenticación

# ROUTE: POST /auth/signup
# Destructivo: úsalo únicamente para crear el administrador inicial.
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "email": "admin@example.com",
  "username": "admin",
  "name": "Administrador Principal",
  "password": "Sup3rSecret2026!"
}

###
# ROUTE: POST /auth/login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Sup3rSecret2026!"
}

###
# ROUTE: POST /auth/refresh
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###
# ROUTE: POST /auth/password/reset/request
POST {{baseUrl}}/auth/password/reset/request
Content-Type: application/json

{
  "email": "usuario@example.com"
}

###
# ROUTE: POST /auth/password/reset/confirm
POST {{baseUrl}}/auth/password/reset/confirm
Content-Type: application/json

{
  "email": "usuario@example.com",
  "code": "123456",
  "newPassword": "NuevaClave2026!",
  "confirmPassword": "NuevaClave2026!"
}

###
# ROUTE: POST /auth/password/reset/admin
# Destructivo: cambia la contraseña y revoca sesiones del usuario objetivo.
POST {{baseUrl}}/auth/password/reset/admin
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "targetUserId": "{{userId}}",
  "newPassword": "NuevaClave2026!",
  "confirmPassword": "NuevaClave2026!"
}

###
# ROUTE: POST /auth/logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{adminToken}}

###
# ROUTE: GET /auth/me
GET {{baseUrl}}/auth/me
Authorization: Bearer {{adminToken}}

### Vendedores e invitaciones

# ROUTE: GET /identity-access/sellers
GET {{baseUrl}}/identity-access/sellers?search=ulloa&active=true&page=1&limit=25&sortBy=name&sortDirection=asc
Authorization: Bearer {{adminToken}}

###
# ROUTE: GET /identity-access/sellers/invitations
GET {{baseUrl}}/identity-access/sellers/invitations?status=PENDIENTE&page=1&limit=25&sortBy=createdAt&sortDirection=desc
Authorization: Bearer {{adminToken}}

###
# ROUTE: POST /identity-access/sellers/invitations
POST {{baseUrl}}/identity-access/sellers/invitations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "vendedor@example.com",
  "username": "vendedor.01",
  "sellerName": "Vendedor Uno",
  "documentId": "001-010190-0001A",
  "phone": "+50588889999",
  "address": "Managua, Nicaragua",
  "roleName": "vendedor"
}

###
# ROUTE: POST /identity-access/sellers/access-code/confirm
POST {{baseUrl}}/identity-access/sellers/access-code/confirm
Content-Type: application/json

{
  "actionToken": "Zfng2QyJ2ZCtwS4fdE5jH5Y68k0W1VnMIkYcMfeqPjE",
  "password": "Sup3rSecret2026!"
}

###
# Alternative manual confirmation body:
# {
#   "email": "vendedor@example.com",
#   "accessCode": "123456",
#   "password": "Sup3rSecret2026!"
# }

###
# ROUTE: POST /identity-access/sellers/access-code/resend
POST {{baseUrl}}/identity-access/sellers/access-code/resend
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "vendedor@example.com"
}

###
# ROUTE: PATCH /identity-access/sellers/invitations/:invitationId/revoke
PATCH {{baseUrl}}/identity-access/sellers/invitations/{{invitationId}}/revoke
Authorization: Bearer {{adminToken}}

###
# ROUTE: PATCH /identity-access/sellers/:sellerId/soft-delete
PATCH {{baseUrl}}/identity-access/sellers/{{sellerId}}/soft-delete
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "reason": "Baja administrativa temporal"
}

###
# ROUTE: DELETE /identity-access/sellers/:sellerId
DELETE {{baseUrl}}/identity-access/sellers/{{sellerId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "reason": "Eliminación definitiva solicitada por administración"
}

### Configuraciones y turnos de sorteo

# ROUTE: GET /draws/configurations
GET {{baseUrl}}/draws/configurations?active=true&page=1&limit=25&sortBy=time&sortDirection=asc
Authorization: Bearer {{adminToken}}

###
# ROUTE: POST /draws/configurations
POST {{baseUrl}}/draws/configurations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "code": "nacional-11am",
  "time": "11:00:00",
  "tuesdayOnly": false,
  "autoGenerateShifts": true,
  "lockSecondsBefore": 60,
  "reopenSecondsAfter": 600,
  "active": true
}

###
# ROUTE: GET /draws/configurations/:configurationId
GET {{baseUrl}}/draws/configurations/{{configurationId}}
Authorization: Bearer {{adminToken}}

###
# ROUTE: PATCH /draws/configurations/:configurationId
PATCH {{baseUrl}}/draws/configurations/{{configurationId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "lockSecondsBefore": 90,
  "reopenSecondsAfter": 900,
  "autoGenerateShifts": true,
  "active": true
}

###
# ROUTE: GET /draws/configurations/:configurationId/delete-impact
# Consulta este impacto antes de ejecutar un borrado físico.
GET {{baseUrl}}/draws/configurations/{{configurationId}}/delete-impact
Authorization: Bearer {{adminToken}}

###
# ROUTE: PATCH /draws/configurations/:configurationId/soft-delete
PATCH {{baseUrl}}/draws/configurations/{{configurationId}}/soft-delete
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "reason": "Configuración duplicada creada por error"
}

###
# ROUTE: DELETE /draws/configurations/:configurationId
# Acción irreversible: reautentica al administrador y borra dependencias en cascada.
DELETE {{baseUrl}}/draws/configurations/{{configurationId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "adminPassword": "{{adminPassword}}",
  "confirmation": "DELETE_DRAW_CONFIGURATION",
  "reason": "Limpieza administrativa aprobada"
}

###
# ROUTE: GET /draws/shifts/active
GET {{baseUrl}}/draws/shifts/active?date={{date}}&page=1&limit=25&sortBy=date&sortDirection=asc
Authorization: Bearer {{adminToken}}

###
# ROUTE: GET /draws/shifts
GET {{baseUrl}}/draws/shifts?date={{date}}&status=ABIERTO&page=1&limit=25&sortBy=date&sortDirection=desc
Authorization: Bearer {{adminToken}}

###
# ROUTE: POST /draws/shifts
POST {{baseUrl}}/draws/shifts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "configurationId": "{{configurationId}}",
  "date": "{{date}}"
}

###
# ROUTE: POST /draws/shifts/auto-generate
POST {{baseUrl}}/draws/shifts/auto-generate
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "date": "{{date}}"
}

###
# ROUTE: PATCH /draws/shifts/:shiftId/block
PATCH {{baseUrl}}/draws/shifts/{{shiftId}}/block
Authorization: Bearer {{adminToken}}

###
# ROUTE: PATCH /draws/shifts/:shiftId/reopen
PATCH {{baseUrl}}/draws/shifts/{{shiftId}}/reopen
Authorization: Bearer {{adminToken}}

###
# ROUTE: PATCH /draws/shifts/:shiftId/close
PATCH {{baseUrl}}/draws/shifts/{{shiftId}}/close
Authorization: Bearer {{adminToken}}

### Límites por número

# ROUTE: GET /number-limits
GET {{baseUrl}}/number-limits?sellerId={{sellerId}}&drawCode=nacional-11am&number=20&active=true&page=1&limit=25&sortBy=createdAt&sortDirection=desc
Authorization: Bearer {{adminToken}}

###
# ROUTE: POST /number-limits
POST {{baseUrl}}/number-limits
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sellerId": "{{sellerId}}",
  "drawConfigurationId": "{{configurationId}}",
  "numbers": ["20", "30", "45"],
  "limitMiles": 100.5,
  "validFrom": "{{date}}",
  "validUntil": "{{date}}"
}

###
# ROUTE: GET /number-limits/:limitId
GET {{baseUrl}}/number-limits/{{limitId}}
Authorization: Bearer {{adminToken}}

###
# ROUTE: PATCH /number-limits/:limitId
PATCH {{baseUrl}}/number-limits/{{limitId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "limitMiles": 125.75,
  "validUntil": null
}

###
# ROUTE: PATCH /number-limits/:limitId/expire
PATCH {{baseUrl}}/number-limits/{{limitId}}/expire
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "expiresOn": "{{date}}"
}

