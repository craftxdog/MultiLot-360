### Ventas

# ROUTE: GET /sales
GET {{baseUrl}}/sales?sellerId={{sellerId}}&shiftId={{shiftId}}&date={{date}}&status=ACTIVA&page=1&limit=25&sortBy=createdAt&sortDirection=desc
Authorization: Bearer {{adminToken}}

###
# ROUTE: POST /sales
# Admin o usuario sin perfil vendedor debe enviar sellerId; vendedor propio
# puede omitirlo y la API usa su perfil autenticado.
POST {{baseUrl}}/sales
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sellerId": "{{sellerId}}",
  "shiftId": "{{shiftId}}",
  "items": [
    { "number": "20", "prizeMiles": 0.5 },
    { "number": "45", "prizeMiles": 1.4 },
    { "number": "99", "prizeMiles": 23.25 }
  ]
}

###
# ROUTE: GET /sales/settings/void-policy
GET {{baseUrl}}/sales/settings/void-policy
Authorization: Bearer {{adminToken}}

###
# ROUTE: PATCH /sales/settings/void-policy
PATCH {{baseUrl}}/sales/settings/void-policy
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "windowMinutes": 10
}

###
# ROUTE: GET /sales/:saleId
GET {{baseUrl}}/sales/{{saleId}}
Authorization: Bearer {{adminToken}}

###
# ROUTE: PATCH /sales/:saleId/void
PATCH {{baseUrl}}/sales/{{saleId}}/void
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "reason": "Cliente solicitó anulación del ticket"
}

