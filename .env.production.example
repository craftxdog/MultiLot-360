APP_NAME="MultiLot 360 API"
APP_WEB_URL=https://alphaby.cloud
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=https://alphaby.cloud
LOG_LEVEL=log

SWAGGER_ENABLED=false
SWAGGER_PATH=docs

SUPABASE_PROJECT_REF=<production-project-ref>
SUPABASE_URL=https://<production-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<production-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<production-service-role-key>

DATABASE_URL="postgresql://postgres.<production-project-ref>:<url-encoded-password>@<exact-session-pooler-host>:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:<url-encoded-password>@db.<production-project-ref>.supabase.co:5432/postgres?sslmode=require&schema=public"
DB_HOST=db.<production-project-ref>.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=<raw-database-password>
DB_DATABASE=postgres
DB_SSL=true
DB_POOL_MAX=3
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

REDIS_HOST=<dokploy-internal-redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<unique-production-redis-password>
REDIS_DB=0
REDIS_KEY_PREFIX=multilot360:production:

REALTIME_ENABLED=true
REALTIME_PATH=/socket.io
REALTIME_MAX_PAYLOAD_BYTES=16384
REALTIME_CONNECT_TIMEOUT_MS=10000
REALTIME_RECOVERY_WINDOW_MS=120000
REALTIME_REDIS_ENABLED=true
REALTIME_REDIS_KEY=multilot360:production:socket.io

MAILERSEND_ENABLED=true
MAILERSEND_SMTP_HOST=smtp.hostinger.com
MAILERSEND_SMTP_PORT=465
MAILERSEND_SMTP_USER=craftzdog@alphaby.cloud
MAILERSEND_SMTP_PASSWORD=<hostinger-mailbox-password>
MAILERSEND_FROM_EMAIL=no-reply@alphaby.cloud
MAILERSEND_FROM_NAME="MultiLot 360"
MAILERSEND_REPLY_TO_EMAIL=soporte@alphaby.cloud

SELLER_ACCESS_CODE_EXPIRES_IN_MINUTES=15
SELLER_ACCESS_CODE_SECRET=<independent-random-secret-at-least-32-characters>
SELLER_ACTIVATION_URL=https://alphaby.cloud/activar-vendedor

AUTH_SIGNUP_ENABLED=false
AUTH_ADMIN_ROLE_NAME=ADMIN
ACCOUNT_CONFIRMATION_URL=https://alphaby.cloud/confirmar-cuenta
PASSWORD_RESET_URL=https://alphaby.cloud/restablecer-contrasena
PASSWORD_RESET_CODE_EXPIRES_IN_MINUTES=60
